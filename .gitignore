# 构建产物
app/
config/

# 依赖与构建产物
node_modules/
dist/
src-tauri/target/
# 仓库根的 target/（立绘生成的临时目录 gen-tmp 也在里面）
target/

# 运行时数据（不进版本库）
library/
cache/
logs/
temp/
backups/
exports/
models/
plugins/data/

# 数据库与密钥
*.db
*.db-journal
*.sqlite
.env
.env.local

# 编辑器/系统
.vscode/
.idea/
Thumbs.db
.DS_Store

# 开发日志
devlog_*.txt

# 开发过程中的临时对照图（如 "xxx-预览.png"）：只用于对话里看效果，不进版本库
screenshots/*-预览.png
*-预览.png
data/

# 自检报告（每次运行生成，不进版本库）
debug-diagnostics/

# 前端测试的编译产物（npm test 生成）
.tmp/

# 打包产物（MSI / 便携包）不进仓库
dist-package/

# 安全加固（2026-10-18 安全审查）：这些文件都可能含用户剧情或密钥，绝不能进 git
*.bak-*    # 修数据时留下的库备份（含全部剧情，绝不能被提交）
*.db-wal    # SQLite WAL 文件（同样含数据）
*.db-shm    # SQLite 共享内存文件
.env.*    # .env 的各种变体
*.pem    # 证书/私钥
*.pfx    # Windows 证书
